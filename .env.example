# ==========================================
# BetterRAG 生产环境运行配置示例 (.env)
# ==========================================

# 服务基础端口与路径
PORT=8000
DATA_DIR=/app/data/workspace
DB_PATH=/app/data/betterrag.db

# 大语言模型配置 (兼容任意标准 OpenAI 协议服务，如 DeepSeek, Qwen, Ollama 等)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=deepseek-chat
CRITIQUE_MODEL=deepseek-chat

# 本地稠密向量模型 (默认使用高精中文模型，免 GPU 单 CPU 毫秒级推理)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 飞书/钉钉告警与审批卡片 Webhook (可选，留空则仅在看板待办中展示)
ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx
